# ==============================================================================
# Vista.CoreX Frontend Environment Variables
# ==============================================================================

# API Base URL (Protokol dahil, sonunda slash '/' olmadan)
# Local: http://localhost:8080
# Production: https://api.vistacore.example.com
VITE_API_BASE_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080

# SignalR Realtime Hub URL (Örn: /hubs/chat, /hubs/benachrichtigung)
# Boş bırakılırsa varsayılan olarak VITE_API_BASE_URL kullanılır
VITE_SIGNALR_HUB_URL=http://localhost:8080/hubs

# Uygulama Çalışma Ortamı (development | staging | production | demo)
VITE_APP_ENV=development

# Loglama Düzeyi (debug | info | warn | error | none)
VITE_LOG_LEVEL=info

# Demo / Mock Modu (true: Backend olmadan mock veriyle çalış, false: Gerçek API'ye bağlan)
VITE_USE_MOCK=false
